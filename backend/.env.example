# ---- App ----
APP_NAME=FacultyLens
INSTITUTION_NAME=Your College Name
FRONTEND_ORIGIN=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
STUDENT_HASH_SALT=change-me-another-long-random-string
# Matches JNTU-style roll numbers such as 21A91A0501 and 22B81A05K2 (a letter in the
# 3rd-last place is used once a branch passes 99 students). Change it if your college uses another format.
ROLL_NO_REGEX=\b\d{2}[A-Z0-9]{2,4}\d{1,2}[A-Z]\d{2}[0-9A-Z]\d\b
MIN_RESPONSES_FOR_DISPLAY=5

# ---- Auth ----
LOGIN_RATE_LIMIT=5/minute
REFRESH_COOKIE_NAME=fl_refresh
# true when the app is served over HTTPS
COOKIE_SECURE=false
# bcrypt cost; 12 is the production default (tests use 4)
BCRYPT_ROUNDS=12

# ---- Database ----
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=facultylens

# ---- ML (CPU only) ----
ML_MODE=light
TORCH_NUM_THREADS=4
NLP_BATCH_SIZE=16
HF_HOME=./.hf_cache
TOX_HIDE=0.70
TOX_REVIEW=0.40
ASPECT_SIM=0.35
SARC_FLAG=0.70

# ---- LLM (Groq free tier: https://console.groq.com/keys) ----
# Leave GROQ_API_KEY empty to run fully on the no-LLM fallback.
GROQ_API_KEY=
# llama-3.3-70b-versatile was shut down on the free tier on 2026-08-16. Check https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=30

# ---- Profile imports (optional) ----
# Optional: a free key from https://www.semanticscholar.org/product/api raises the shared rate limit.
S2_API_KEY=
IMPORT_TIMEOUT_SECONDS=15
