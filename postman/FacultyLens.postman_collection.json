        {
          "name": "PUT /faculty/:id/profile-data",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/faculty/{{facultyId}}/profile-data",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "faculty",
                "{{facultyId}}",
                "profile-data"
              ]
            },
            "description": "Replaces the editable sections. Items without an id get one; keep ids when editing so later grounding stays stable.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
